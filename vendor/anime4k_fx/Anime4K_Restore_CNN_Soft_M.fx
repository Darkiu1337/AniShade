technique Anime4K_Restore_CNN_Soft_M
{
    pass Copy
    {
        VertexShader = FullscreenVS;
        PixelShader = PS_Copy;
        RenderTarget0 = texInput;
    }
    pass Shift3
    {
        VertexShader = FullscreenVS;
        PixelShader = PS_Shift3;
        RenderTarget0 = texPrev4;
    }
    pass Shift2
    {
        VertexShader = FullscreenVS;
        PixelShader = PS_Shift2;
        RenderTarget0 = texPrev3;
    }
    pass Shift1
    {
        VertexShader = FullscreenVS;
        PixelShader = PS_Shift1;
        RenderTarget0 = texPrev2;
    }
    pass p0
    {
        VertexShader = FullscreenVS;
        PixelShader = PS0;
    RenderTarget0 = conv2d_tf;
    }
    pass p1
    {
        VertexShader = FullscreenVS;
        PixelShader = PS1;
    RenderTarget0 = conv2d_1_tf;
    }
    pass p2
    {
        VertexShader = FullscreenVS;
        PixelShader = PS2;
    RenderTarget0 = conv2d_2_tf;
    }
    pass p3
    {
        VertexShader = FullscreenVS;
        PixelShader = PS3;
    RenderTarget0 = conv2d_3_tf;
    }
    pass p4
    {
        VertexShader = FullscreenVS;
        PixelShader = PS4;
    RenderTarget0 = conv2d_4_tf;
    }
    pass p5
    {
        VertexShader = FullscreenVS;
        PixelShader = PS5;
    RenderTarget0 = conv2d_5_tf;
    }
    pass p6
    {
        VertexShader = FullscreenVS;
        PixelShader = PS6;
    RenderTarget0 = conv2d_6_tf;
    }
    pass p7
    {
        VertexShader = FullscreenVS;
        PixelShader = PS7;
    RenderTarget0 = texPrev1;
    }
    pass Present
    {
        VertexShader = FullscreenVS;
        PixelShader = PS_Present;
    }
}

