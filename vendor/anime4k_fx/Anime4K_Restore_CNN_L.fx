{
    Texture = BackBufferTex;
    MinFilter = POINT;
    MagFilter = POINT;
    MipFilter = POINT;
    AddressU = CLAMP;
    AddressV = CLAMP;
    SRGBTexture = FALSE;
};

// Snapshot of the frame taken before any pass runs. RGB holds sanitized input;
// A holds 1.0 when the pixel matches our own previous output (un-redrawn swapchain
// region such as Chromium letterbox/pillarbox bars or static tiles).
texture texInput
{
    Width = BUFFER_WIDTH;
    Height = BUFFER_HEIGHT;
    Format = RGBA16F;
    MipLevels = 1;
};
sampler sampInput
{
    Texture = texInput;
    MinFilter = POINT;
    MagFilter = POINT;
    MipFilter = POINT;
    AddressU = CLAMP;
    AddressV = CLAMP;
    SRGBTexture = FALSE;
};

