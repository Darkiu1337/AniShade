#ifndef ANISHADE_TOP_MARGIN
#define ANISHADE_TOP_MARGIN 0
#endif
#ifndef ANISHADE_CONTENT_ASPECT
#define ANISHADE_CONTENT_ASPECT 0.0
#endif


void FullscreenVS(uint id : SV_VertexID, out float4 position : SV_Position, out float2 texcoord : TEXCOORD0)
{
    texcoord = float2((id << 1) & 2, id & 2);
    position = float4(texcoord * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
}


// ReShade FX matrix constructors/multiplication are ambiguous across versions;
// expand the 4x4 multiply into four dot products (same approach as Magpie).
float4 anishade_mul(float4 r0, float4 r1, float4 r2, float4 r3, float4 v)
{
    return float4(dot(v, r0), dot(v, r1), dot(v, r2), dot(v, r3));
}

float anishade_maxdiff(float3 a, float3 b)
{
    float3 d = abs(a - b);
    return max(d.r, max(d.g, d.b));
}

float4 PS_Copy(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target
{
    float2 pos = (floor(uv * float2(BUFFER_WIDTH, BUFFER_HEIGHT)) + 0.5) * float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);
    float4 c = tex2Dlod(sampMain, float4(pos, 0, 0));
    // Guard against NaN/Inf/undefined pixels in the swap chain.
    float3 safe_rgb = float3(
        (c.r >= 0.0) ? min(c.r, 1.0) : 0.0,
        (c.g >= 0.0) ? min(c.g, 1.0) : 0.0,
        (c.b >= 0.0) ? min(c.b, 1.0) : 0.0
    );
    float4 p1 = tex2Dlod(sampPrev1, float4(pos, 0, 0));
    float4 p2 = tex2Dlod(sampPrev2, float4(pos, 0, 0));
    float4 p3 = tex2Dlod(sampPrev3, float4(pos, 0, 0));
    float4 p4 = tex2Dlod(sampPrev4, float4(pos, 0, 0));
    float eps = 0.4 / 255.0;
    bool fb =
        (p1.a > 0.5 && anishade_maxdiff(safe_rgb, p1.rgb) < eps) ||
        (p2.a > 0.5 && anishade_maxdiff(safe_rgb, p2.rgb) < eps) ||
        (p3.a > 0.5 && anishade_maxdiff(safe_rgb, p3.rgb) < eps) ||
        (p4.a > 0.5 && anishade_maxdiff(safe_rgb, p4.rgb) < eps);
    return float4(safe_rgb, fb ? 1.0 : 0.0);
}

float4 PS_Shift3(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target
{
    float2 pos = (floor(uv * float2(BUFFER_WIDTH, BUFFER_HEIGHT)) + 0.5) * float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);
    return tex2Dlod(sampPrev3, float4(pos, 0, 0));
}

float4 PS_Shift2(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target
{
    float2 pos = (floor(uv * float2(BUFFER_WIDTH, BUFFER_HEIGHT)) + 0.5) * float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);
    return tex2Dlod(sampPrev2, float4(pos, 0, 0));
}

float4 PS_Shift1(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target
{
    float2 pos = (floor(uv * float2(BUFFER_WIDTH, BUFFER_HEIGHT)) + 0.5) * float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);
    return tex2Dlod(sampPrev1, float4(pos, 0, 0));
}

float4 PS_Present(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target
{
    float2 pos = (floor(uv * float2(BUFFER_WIDTH, BUFFER_HEIGHT)) + 0.5) * float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);
    return float4(tex2Dlod(sampPrev1, float4(pos, 0, 0)).rgb, 1.0);
}

float4 PS0(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target
{
    float2 pos = (floor(uv * float2(BUFFER_WIDTH, BUFFER_HEIGHT)) + 0.5) * float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);

    float anishade_top = float(ANISHADE_TOP_MARGIN);
    float2 anishade_lo = float2(0.0, anishade_top / float(BUFFER_HEIGHT));
    float2 anishade_hi = float2(1.0, 1.0);
    if (ANISHADE_CONTENT_ASPECT > 0.0)
    {
        float avail_w = float(BUFFER_WIDTH);
        float avail_h = max(float(BUFFER_HEIGHT) - anishade_top, 1.0);
        float buffer_aspect = avail_w / avail_h;
        float content_w, content_h;
        if (buffer_aspect > ANISHADE_CONTENT_ASPECT)
        {
            content_h = avail_h;
            content_w = content_h * ANISHADE_CONTENT_ASPECT;
        }
        else
        {
            content_w = avail_w;
            content_h = content_w / ANISHADE_CONTENT_ASPECT;
        }
        float x0 = (avail_w - content_w) * 0.5;
        float y0 = anishade_top + (avail_h - content_h) * 0.5;
        anishade_lo = float2(x0 / float(BUFFER_WIDTH), y0 / float(BUFFER_HEIGHT));
        anishade_hi = float2((x0 + content_w) / float(BUFFER_WIDTH), (y0 + content_h) / float(BUFFER_HEIGHT));
        // Safety: a wrong/absurd aspect must never mask most of the screen.
        if ((anishade_hi.x - anishade_lo.x) * (anishade_hi.y - anishade_lo.y) < 0.25)
        {
            anishade_lo = float2(0.0, anishade_top / float(BUFFER_HEIGHT));
            anishade_hi = float2(1.0, 1.0);
        }
    }
#define P0_go_0(x_off, y_off) (MAIN_texOff(float2(x_off, y_off)))

    float4 result = anishade_mul(float4(-0.23234928, -0.25936925, -0.11045535, 0.0), float4(-0.070085905, -0.20185155, -0.11106335, 0.0), float4(0.0040122913, 0.022299573, -0.12113332, 0.0), float4(0.21575761, 0.2812235, -0.49919847, 0.0), P0_go_0(-1.0, -1.0));
    result += anishade_mul(float4(-0.48585954, -0.24872562, -0.027792914, 0.0), float4(-0.058959674, 0.2667282, -0.06700173, 0.0), float4(0.11114158, -0.107163996, -0.10966316, 0.0), float4(-0.1971666, 0.12475151, 0.09399147, 0.0), P0_go_0(-1.0, 0.0));
    result += anishade_mul(float4(-0.16666615, -0.1522582, 0.074704535, 0.0), float4(-0.15644506, 0.15417537, 0.2168164, 0.0), float4(0.048309084, -0.23017146, 0.2077189, 0.0), float4(0.19122206, 0.09460856, -0.29264635, 0.0), P0_go_0(-1.0, 1.0));
    result += anishade_mul(float4(0.3167284, 0.20206359, -0.0006390347, 0.0), float4(-0.20522436, 0.012589764, -0.09853893, 0.0), float4(-0.050071932, -0.1251284, 0.14406726, 0.0), float4(-0.036290437, -0.2911492, 0.33612582, 0.0), P0_go_0(0.0, -1.0));
    result += anishade_mul(float4(0.13786903, 0.5614157, -0.075360805, 0.0), float4(0.51342535, 0.011565876, 0.018496322, 0.0), float4(-0.44004235, 0.5419984, 0.12582661, 0.0), float4(-0.23918492, -0.15937872, 0.40117717, 0.0), P0_go_0(0.0, 0.0));
    result += anishade_mul(float4(0.19644158, -0.03395398, 0.18238129, 0.0), float4(0.12697817, -0.17465135, -0.0063141263, 0.0), float4(0.15092115, -0.04086773, -0.26402372, 0.0), float4(0.1963961, 0.09187623, -0.28761682, 0.0), P0_go_0(0.0, 1.0));
    result += anishade_mul(float4(-0.010849395, -0.1121466, 0.18295552, 0.0), float4(0.15082607, 0.21590506, 0.2425088, 0.0), float4(0.095264904, 0.029462064, 0.121624336, 0.0), float4(-0.038952388, -0.65400773, 0.7189011, 0.0), P0_go_0(1.0, -1.0));
    result += anishade_mul(float4(0.17197245, 0.071163684, -0.11754515, 0.0), float4(-0.04397748, -0.20590816, 0.006909551, 0.0), float4(0.18232836, 0.39706057, 0.018450081, 0.0), float4(-0.04471754, -0.5452873, 0.5686299, 0.0), P0_go_0(1.0, 0.0));
    result += anishade_mul(float4(0.077441245, -0.04312338, -0.11017497, 0.0), float4(-0.25645187, -0.08810754, -0.16309647, 0.0), float4(-0.19979256, -0.059999906, 0.026156282, 0.0), float4(-0.010363122, 0.38630447, -0.35432625, 0.0), P0_go_0(1.0, 1.0));
    result += float4(-0.03509807, 0.029998481, -0.08691994, -0.017055636);
    return result;

}


