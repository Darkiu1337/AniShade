    result += anishade_mul(float4(-0.31584853, -0.50103146, -0.32097813, 0.0), float4(0.07527119, -0.07217874, -0.051580857, 0.0), float4(0.30713862, 0.512807, -0.022466356, 0.0), float4(-0.34014285, -0.09597398, 0.01148551, 0.0), P0_go_0(0.0, -1.0));
    result += anishade_mul(float4(-0.026032459, -0.27421117, 0.07819544, 0.0), float4(-0.04193211, 1.0906446, 0.06003738, 0.0), float4(0.37703893, -0.049654085, 0.1405805, 0.0), float4(-0.031916667, -0.19814016, -0.0064135445, 0.0), P0_go_0(0.0, 0.0));
    result += anishade_mul(float4(0.041450135, 0.53344345, 0.2325609, 0.0), float4(0.11319654, 0.30857387, -0.027797326, 0.0), float4(-0.23237701, -0.057264958, -0.04544767, 0.0), float4(0.08443178, -0.1575803, -0.18720597, 0.0), P0_go_0(0.0, 1.0));
    result += anishade_mul(float4(0.2531829, 0.20126024, 0.29951036, 0.0), float4(-0.074966915, -0.5380133, 0.17123336, 0.0), float4(-0.27800754, -0.15082566, -0.01681872, 0.0), float4(-0.3146097, -0.19021043, -0.12574998, 0.0), P0_go_0(1.0, -1.0));
