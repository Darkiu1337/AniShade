    result += anishade_mul(float4(-0.2789985, -0.48472273, -0.27021924, 0.0), float4(0.054727737, -0.011525487, -0.044563178, 0.0), float4(0.22577816, 0.5354349, 0.008232271, 0.0), float4(-0.49625716, -0.08814955, -0.13480483, 0.0), P0_go_0(0.0, -1.0));
    result += anishade_mul(float4(-0.18203105, -0.4335171, 0.011992759, 0.0), float4(0.09277001, 1.2275106, 0.060106967, 0.0), float4(0.27071548, -0.07663438, 0.11002492, 0.0), float4(-0.17773713, -0.29020032, -0.046098012, 0.0), P0_go_0(0.0, 0.0));
    result += anishade_mul(float4(0.08363418, 0.38670546, 0.0846784, 0.0), float4(0.063420765, 0.13577081, -0.057097007, 0.0), float4(-0.10278259, 0.048631024, 0.06049236, 0.0), float4(0.09357691, -0.024960777, 0.042082917, 0.0), P0_go_0(0.0, 1.0));
    result += anishade_mul(float4(0.12315548, 0.06479095, 0.08360464, 0.0), float4(-0.056513585, -0.36984903, 0.12835538, 0.0), float4(-0.09826642, -0.12512982, -0.005067881, 0.0), float4(-0.17079762, 0.042867575, 0.02542005, 0.0), P0_go_0(1.0, -1.0));
